+          <Wrap width="100%" justify="flex-end" spacing="2">
+            <WrapItem>
+              <Button variant="ghost" onClick={onClose}>
+                Close
+              </Button>
+            </WrapItem>
+            <WrapItem>
+              <Button
+                leftIcon={copied ? <FiCheck /> : <FiCopy />}
+                onClick={() => void copyLink()}
+                variant="outline"
+              >
+                {copied ? "Copied" : "Copy link"}
+              </Button>
+            </WrapItem>
+            {canShare ? (
+              <WrapItem>
+                <Button
+                  leftIcon={<FiShare2 />}
+                  onClick={() => void share()}
+                  variant="outline"
+                >
+                  Share
+                </Button>
+              </WrapItem>
+            ) : null}
+            <WrapItem>
+              <Button
+                leftIcon={<FiDownload />}
+                onClick={() => void download()}
+                isLoading={isDownloading}
+                loadingText="Creating PNG"
+                variant="primary"
+              >
+                Download PNG
+              </Button>
+            </WrapItem>
+          </Wrap>
+        </ModalFooter>
+      </ModalContent>
+    </Modal>
+  );
+}
