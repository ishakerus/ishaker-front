+          py={{ base: "10", md: "16" }}
+        >
+          <VStack spacing={{ base: "5", md: "7" }} textAlign="center" w="full">
+            <Heading
+              as="h1"
+              fontSize={{ base: "2xl", md: "4xl" }}
+              lineHeight="short"
+            >
+              Scan at the iShaker machine
+            </Heading>
+
+            <Box
+              bg="white"
+              borderRadius="2xl"
+              p="4"
+              width="288px"
+              maxW="100%"
+              lineHeight="0"
+              boxShadow="0 24px 70px rgba(0,0,0,0.36)"
+            >
+              <QRCode
+                value={url}
