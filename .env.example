# Shared override for entering an existing client portal by nickname/email.
# It does not authenticate /admin/dashboard.
ADMIN_PASSWORD=replace-with-a-long-random-secret
NEXT_PUBLIC_STRAPI_URL=https://admin.ishaker.xyz
STRAPI_URL=https://admin.ishaker.xyz
EXCHANGE_RATE_API_URL=https://api.frankfurter.app/latest?from=USD

# Individual Strapi Support accounts authenticate the custom admin dashboard.
# Generate once (at least 32 random characters), keep server-side, and share across replicas.
ADMIN_SESSION_SECRET=
# Optional canonical frontend origin for CSRF checks, e.g. https://ishaker.xyz
APP_ORIGIN=
